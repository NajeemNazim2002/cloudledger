# Neon (Dashboard > Connection Details). Use the pooled string here.
DATABASE_URL=
# Neon direct (non-pooled) string, used for migrations.
DIRECT_URL=

# Admin sign-in. Use your own values; keep this file out of source control.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Generate a random value of at least 32 characters for this signing secret.
ADMIN_SESSION_SECRET=

# Admin password recovery (Resend)
ADMIN_RECOVERY_EMAIL=cloudledger78@gmail.com
RESEND_API_KEY=
# Set this to a sender address verified with Resend.
RESEND_FROM_EMAIL=
# Set to your public site origin in production, e.g. https://cloudledger.example
APP_URL=http://localhost:3000
